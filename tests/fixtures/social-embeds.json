{
  "image": {
    "$type": "app.bsky.embed.images#view",
    "images": [
      {
        "thumb": "https://cdn.example/thumb.jpg",
        "fullsize": "https://cdn.example/full.jpg",
        "alt": "A & <scene>",
        "aspectRatio": {
          "width": 1920,
          "height": 1080
        }
      }
    ]
  },
  "video": {
    "$type": "app.bsky.embed.video#view",
    "playlist": "https://video.example/playlist.m3u8",
    "thumbnail": "https://video.example/poster.jpg",
    "alt": "An experiment",
    "aspectRatio": {
      "width": 1280,
      "height": 720
    }
  },
  "external": {
    "$type": "app.bsky.embed.external#view",
    "external": {
      "uri": "https://news.example/story?a=1&b=2",
      "title": "An interesting <headline>",
      "description": "A preview, not executable <script>.",
      "thumb": "https://news.example/cover.jpg"
    }
  },
  "recordWithMedia": {
    "$type": "app.bsky.embed.recordWithMedia#view",
    "media": {
      "$type": "app.bsky.embed.images#view",
      "images": [
        {
          "thumb": "https://cdn.example/thumb.jpg",
          "fullsize": "https://cdn.example/full.jpg",
          "alt": "A & <scene>",
          "aspectRatio": {
            "width": 1920,
            "height": 1080
          }
        }
      ]
    },
    "record": {
      "$type": "app.bsky.embed.record#view",
      "record": {
        "$type": "app.bsky.embed.record#viewRecord",
        "uri": "at://did:plc:quoted/app.bsky.feed.post/quoted-key",
        "author": {
          "did": "did:plc:quoted",
          "handle": "quoted.example"
        },
        "value": {
          "$type": "app.bsky.feed.post",
          "text": "☕ read here",
          "createdAt": "2026-11-16T12:00:00Z",
          "facets": [
            {
              "index": {
                "byteStart": 9,
                "byteEnd": 13
              },
              "features": [
                {
                  "$type": "app.bsky.richtext.facet#link",
                  "uri": "https://news.example/"
                }
              ]
            }
          ]
        },
        "embeds": [
          {
            "$type": "app.bsky.embed.video#view",
            "playlist": "https://video.example/playlist.m3u8",
            "thumbnail": "https://video.example/poster.jpg",
            "alt": "An experiment",
            "aspectRatio": {
              "width": 1280,
              "height": 720
            }
          },
          {
            "$type": "app.bsky.embed.external#view",
            "external": {
              "uri": "https://news.example/story?a=1&b=2",
              "title": "An interesting <headline>",
              "description": "A preview, not executable <script>.",
              "thumb": "https://news.example/cover.jpg"
            }
          }
        ],
        "labels": [
          {
            "val": "graphic-media"
          }
        ]
      }
    }
  },
  "gallery": {
    "$type": "app.bsky.embed.gallery#view",
    "items": [
      {
        "$type": "app.bsky.embed.gallery#viewImage",
        "fullsize": "https://cdn.example/gallery.jpg",
        "thumbnail": "https://cdn.example/gallery-small.jpg",
        "alt": "Gallery image",
        "aspectRatio": {
          "width": 4,
          "height": 3
        }
      }
    ]
  },
  "blockedQuote": {
    "$type": "app.bsky.embed.record#view",
    "record": {
      "$type": "app.bsky.embed.record#viewBlocked",
      "blocked": true,
      "uri": "at://did:plc:blocked/app.bsky.feed.post/hidden",
      "author": {
        "did": "did:plc:blocked"
      },
      "value": {
        "text": "MUST NOT LEAK"
      },
      "embeds": [
        {
          "$type": "app.bsky.embed.images#view",
          "images": [
            {
              "thumb": "https://cdn.example/thumb.jpg",
              "fullsize": "https://cdn.example/full.jpg",
              "alt": "A & <scene>",
              "aspectRatio": {
                "width": 1920,
                "height": 1080
              }
            }
          ]
        }
      ]
    }
  },
  "mastodon": {
    "sensitive": true,
    "spoiler_text": "Source warning",
    "media_attachments": [
      {
        "type": "image",
        "url": "https://media.example/photo.jpg",
        "preview_url": "https://media.example/photo-small.jpg",
        "description": "A photograph",
        "meta": {
          "original": {
            "width": 800,
            "height": 600
          }
        }
      },
      {
        "type": "gifv",
        "url": "https://media.example/animation.mp4",
        "preview_url": "https://media.example/animation.jpg",
        "description": "An animation"
      },
      {
        "type": "audio",
        "url": "https://media.example/sound.mp3",
        "description": "A recording"
      }
    ],
    "card": {
      "url": "https://news.example/article",
      "title": "A card",
      "description": "A description",
      "image": "https://news.example/cover.jpg",
      "provider_name": "Example News",
      "html": "<iframe src=\"https://evil.example/\"></iframe>"
    }
  }
}
